<?xml version="1.0" encoding="utf-8"?>
<!-- Add or edit a shoe -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <EditText
            android:id="@+id/shoe_dialog_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/Shoe_name"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <!-- Opens a date picker -->
        <EditText
            android:id="@+id/shoe_dialog_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="@string/Shoe_purchase_date"
            android:importantForAutofill="no"
            android:inputType="date" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/shoe_dialog_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:hint="@string/Shoe_price"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLines="1" />

            <!-- Free text: "270", "US 9", "9.5 EU" -->
            <EditText
                android:id="@+id/shoe_dialog_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/Shoe_size"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                tools:ignore="TextFields" />
        </LinearLayout>

        <EditText
            android:id="@+id/shoe_dialog_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="@string/Notes"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minLines="2" />

        <CheckBox
            android:id="@+id/shoe_dialog_default"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/Shoe_default" />

        <CheckBox
            android:id="@+id/shoe_dialog_retired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Shoe_retired" />
    </LinearLayout>
</ScrollView>
