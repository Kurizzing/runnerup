<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/history_section_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:textAppearance="@style/HistoryMonth" />

    <LinearLayout
        android:id="@+id/history_feed_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_background"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/history_list_emblem"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/icon_circle_background"
                android:contentDescription="@string/Sport"
                android:padding="10dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/history_feed_sport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@string/fontFamily_medium"
                    android:textColor="@color/colorText"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/history_list_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textAppearance="@style/HistoryMeta" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/history_feed_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/HistoryTitle" />

        <TextView
            android:id="@+id/history_feed_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:divider="@drawable/divider_vertical"
            android:dividerPadding="2dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:showDividers="middle">

            <LinearLayout
                android:id="@+id/history_feed_distance_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/history_feed_distance_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Distance"
                    android:textAppearance="@style/HistoryStatLabel" />

                <TextView
                    android:id="@+id/history_feed_distance"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAppearance="@style/HistoryStatValue"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/history_feed_duration_box"
                android:layout_width="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/history_feed_duration_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Time"
                    android:textAppearance="@style/HistoryStatLabel" />

                <TextView
                    android:id="@+id/history_feed_duration"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAppearance="@style/HistoryStatValue"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/history_feed_pace_box"
                android:layout_width="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/history_feed_pace_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Pace"
                    android:textAppearance="@style/HistoryStatLabel" />

                <TextView
                    android:id="@+id/history_feed_pace"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAppearance="@style/HistoryStatValue"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/history_feed_hr_box"
                android:layout_width="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/history_feed_hr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Heart_rate"
                    android:textAppearance="@style/HistoryStatLabel" />

                <TextView
                    android:id="@+id/history_feed_hr"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textAppearance="@style/HistoryStatValue"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>

        </LinearLayout>

        <org.runnerup.widget.RouteView
            android:id="@+id/history_feed_route"
            android:layout_width="match_parent"
            android:layout_height="180dp" />
    </LinearLayout>
</LinearLayout>
