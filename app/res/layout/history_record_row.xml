<?xml version="1.0" encoding="utf-8"?>
<!-- Row of the medals and monthly views: badge or sport icon, title and subtitle, value -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/record_badge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/medal_circle"
        android:fontFamily="@string/fontFamily_medium"
        android:gravity="center"
        android:textColor="#1A1D23"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/record_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/icon_circle_background"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/record_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/colorText"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/record_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/HistoryMeta" />
    </LinearLayout>

    <TextView
        android:id="@+id/record_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:textAppearance="@style/HistoryMeta" />
</LinearLayout>
